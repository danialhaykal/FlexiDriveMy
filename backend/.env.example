# Copy this file to .env for local development.
# Run scripts/setup_local_db.sql once against your local Postgres 18 instance
# to create the role/database these values point at (see README.md).

# Generate your own: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-real-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=flexidrivemy
POSTGRES_USER=flexidrivemy
POSTGRES_PASSWORD=set-this-to-match-the-password-you-chose-in-scripts/setup_local_db.sql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis isn't running in this dev environment - CELERY_TASK_ALWAYS_EAGER=True
# makes F012's retrain task run inline instead. Flip both once Redis is up.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Milliseconds before an F013 audit log query is cancelled server-side.
AUDIT_LOG_QUERY_TIMEOUT_MS=8000

# F012: where trained model files / uploaded CSVs are stored. Leave unset
# to default to backend/ml_models/ and backend/ml_data/uploads/.
# ML_MODELS_DIR=
# ML_DATASET_UPLOAD_DIR=
# F006: seconds predict_resale_curve()/explain_resale_prediction() each
# wait before falling back (QA audit M8: lowered from 5s now that the
# deployed model is cached in-process, see config/settings.py's comment).
ML_INFERENCE_TIMEOUT_SECONDS=2

# F008: where generated PDF reports are stored. Leave unset to default to
# backend/exports/pdf/. WeasyPrint needs a native GObject/Pango/cairo
# runtime it won't find on plain Windows (works out of the box on Linux) -
# see apps/exports/pdf.py and README.md.
# PDF_EXPORTS_DIR=
PDF_COMPILATION_TIMEOUT_SECONDS=30
